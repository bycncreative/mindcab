// mindcab.exe 的 PE 资源：图标 + 版本信息。
// 图标：资源管理器 / 任务栏 / 固定到任务栏时显示（生成方式见 tools/make_ico.zig）；
//       窗口标题栏的运行时图标在 main.zig 里用 @embedFile 的 PNG 另行设置。
// 版本信息：杀软（尤其 360 的 QVM/云查杀）对「无公司名、无版本号、无签名」的
//       新编译 exe 打分很差，补齐 VS_VERSIONINFO 是最省事的降误报手段。
//       注意 OriginalFilename / InternalName 必须与产物名一致（build.zig 里
//       exe.name = "mindcab"），发布时不要再手动改名，否则反而像"伪装"。
//       版本号必须跟 src/app.zig 的 app_version 同步（关于对话框读的是那个），
//       exe 属性和界面里显示的版本对不上也是启发式扣分项。
1 ICON "assets/zmind.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "bingyecn@163.com"
      VALUE "FileDescription", "mindcab - 思维导图编辑器"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "mindcab"
      VALUE "OriginalFilename", "mindcab.exe"
      VALUE "ProductName", "mindcab个人思维导图"
      VALUE "ProductVersion", "2.0.0"
      VALUE "LegalCopyright", "Copyright (C) 2026 bingyecn@163.com"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
